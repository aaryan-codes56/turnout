# Copy to .env and fill in. Never commit .env.

# --- Needed from Phase 0 ---

# Matches docker-compose.yml. In production this is the Neon connection string.
DATABASE_URL=postgres://turnout:turnout@localhost:5434/turnout

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. Exact domain match only; subdomains are not implied.
ALLOWED_EMAIL_DOMAINS=nst.rishihood.edu.in,rishihood.edu.in

# Base URL of the web app, with no trailing slash.
APP_URL=http://localhost:3000

# --- Optional until the phase that uses them ---

# Phase 4: Razorpay test mode. Only RAZORPAY_KEY_ID is ever sent to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phase 3: signs QR tickets. Generate with: openssl rand -base64 32
QR_SIGNING_SECRET=

# Phase 2: ticket emails.
RESEND_API_KEY=
EMAIL_FROM=

# Phase 5: error reporting.
SENTRY_DSN=
